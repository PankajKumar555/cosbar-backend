# Copy to .env and fill in real values. Never commit .env itself.

PORT=5000

# Include the database name before the "?" — without it Mongoose silently
# connects to the default "test" database.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/cosbar?retryWrites=true&w=majority

# Long random string. Rotating this invalidates every issued token.
JWT_SECRET=

# Comma-separated list of allowed browser origins. REQUIRED in production —
# the fallback is localhost only, which blocks a deployed frontend.
ALLOWED_ORIGINS=https://your-frontend.example.com

# Email (SMTP) — used for forgot-password and order confirmations
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# The "From" address (usually the same as SMTP_USER)
EMAIL_FROM=

# Public frontend URL, used to build password-reset links
FRONTEND_URL=https://your-frontend.example.com
